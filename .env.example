# Pyronear API
API_URL=https://api.pyronear.org

# Camera credentials (shared across all cameras unless overridden per-camera in credentials.json)
CAM_USER=my_dummy_login
CAM_PWD=my_dummy_pwd

# MediaMTX server IP (used by pyro-camera-api to build SRT output URLs)
MEDIAMTX_SERVER_IP=1.2.3.4

# Tokens for "rest" adapter cameras. Reference them from credentials.json as
# ${VAR}, e.g. {"headers": {"Authorization": "Bearer ${VIGILANT_TOKEN}"}}.
# VIGILANT_TOKEN=my_dummy_token

# Docker image tag for both services (defaults to "latest" if unset)
# Set to a specific version for pinned deployments, e.g. PYRO_ENGINE_VERSION=1.2.0
PYRO_ENGINE_VERSION=latest

# Stuck-camera detector: reboots a camera through its API when it stops giving fresh
# images, freezes, or (PTZ) stops rotating during patrol. At most 3 reboots per day.
# Enabled by default. Set to "false" to disable.
ENABLE_STUCK_DETECTOR=true
# Optional temporal validation of alerts: both lines together. The model is downloaded on first start.
# COMPOSE_PROFILES=temporal
# TEMPORAL_API_URL=http://localhost:8082

# Save every captured frame (true/false, default false)
SAVE_CAPTURED_FRAMES=false
# Where saved frames go, inside the container. Default is the USB key mounted on /mnt/usb:
# when the key is missing nothing is saved. Set /usr/src/app/data/backup to save on the SD card.
FRAMES_DIR=/usr/src/app/mnt/usb/frames
# Max MB used on the disk holding the frames (the whole SD card in local mode) before the oldest
# days are deleted. Whatever the value, 10% of the disk is always kept free, so a small key works
# with the default.
BACKUP_SIZE_MB=80000

# Log verbosity for all three services: DEBUG, INFO, WARNING, ERROR.
# INFO keeps one summary line per inference round and per patrol cycle;
# DEBUG adds per-pose captures, raw predictions and HTTP access logs.
LOG_LEVEL=INFO

# Testing only: never reboot a camera that looks frozen or does not move, to work
# with a still PTZ at home or a mock camera. Logged as a warning at startup.
ALLOW_STILL_CAMERA=false
